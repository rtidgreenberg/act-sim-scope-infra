<?xml version="1.0"?>
<dds>
  <qos_library name="ACT_RS_PRIORITY_TEST">
    <qos_profile name="on_demand" base_name="ACT_QOS_LIB::rs_priority_participant">
      <domain_participant_qos>
        <transport_builtin><mask>UDPv4</mask></transport_builtin>
        <discovery>
          <initial_peers><element>127.0.0.1</element></initial_peers>
        </discovery>
        <property>
          <value>
            <element>
              <name>dds.flow_controller.token_bucket.act_rs.token_bucket.period.sec</name>
              <value>DURATION_INFINITE_SEC</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.act_rs.token_bucket.period.nanosec</name>
              <value>DURATION_INFINITE_NSEC</value>
            </element>
          </value>
        </property>
      </domain_participant_qos>
    </qos_profile>
  </qos_library>
</dds>
