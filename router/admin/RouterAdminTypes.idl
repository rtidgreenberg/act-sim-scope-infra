// RouterAdminTypes.idl — generated admin command/status types for the ACT C++ router.
//
// Transcribed from docs/cpp_router/command-status.md "Admin IDL Sketch" (authoritative).
// These types ride the router's LAN-local participant (control plane is LAN-local;
// see command-status.md) and are generated + loaded on both ends independently of the
// ACT payload XML.
//
// Keying: RouterStatus is keyed by (target_node, target_router) so each router instance
// is one instance on the status topic. Key idiom (@key on its own line, string keys)
// matches the proven spikes (spikes/isc_recovery/IscState.idl, relay/cpp/ActState.idl).
//
// No IDL module wrapper: the sketch uses bare type names and status text refers to them
// as such; kept flat to minimize divergence from the authoritative spec for this POC.

enum RouterCommandKind {
    ENABLE_ROUTE,
    DISABLE_ROUTE,
    UPDATE_ROUTE,
    SET_PARTICIPANT_PARTITION,
    // Runtime per-route partition change (7b, D69): applies the command's embedded
    // route.input.subscriber_partition / route.output.publisher_partition to the named
    // route — desired spec updated, live builds adjusted in place via set_qos (D15:
    // pub/sub partition is runtime-mutable with automatic rematching; no rebuild).
    SET_ROUTE_PARTITION
};

// Trimmed to exactly today's ControllerEventKind set (D46): no ROUTE_DATA_READY (no such
// controller event exists; per-sample journaling would be a firehose) or SHUTDOWN_REQUESTED
// (shutdown is procedural, not a queued event); TOPIC_QOS_WARNING added (D39/D45).
enum ControllerJournalEventKind {
    JOURNAL_COMMAND_RECEIVED,
    JOURNAL_PUBLICATION_DISCOVERED,
    JOURNAL_SUBSCRIPTION_DISCOVERED,
    JOURNAL_ENDPOINT_LOST,
    JOURNAL_TOPIC_ENTITIES_READY,
    JOURNAL_TOPIC_TEARDOWN_COMPLETE,
    JOURNAL_ROUTE_ENTITY_ERROR,
    JOURNAL_TOPIC_QOS_WARNING,
    JOURNAL_TOPIC_MATCH_CHANGED,  // matched-count change on a live build (D64/D66)
    JOURNAL_TYPE_RESOLVED         // topic's type learned from the wire (7c, D64/D70)
};

enum RouterRouteOperationalState {
    ROUTE_DISABLED,
    ROUTE_WAITING_FOR_DISCOVERY,
    ROUTE_RESOLVING,
    ROUTE_ENABLED,
    ROUTE_DEGRADED,
    ROUTE_ERROR
};

// Under create-and-observe (D64/D66) this reports the live build's matched counts —
// DDS is the matching authority: READY = both legs matched (>=1 each), PARTIAL = one
// leg matched, NONE = no entities or nothing matched yet.
enum RouterRouteDiscoveryState {
    DISCOVERY_NONE,      // no live entities, or neither leg has a matched peer
    DISCOVERY_PARTIAL,   // exactly one leg has a matched peer
    DISCOVERY_READY      // both legs matched: input writer(s) and output reader(s)
};

// Per-topic entity state (design-decisions.md D11). Discovery facts and entity lifecycle
// are tracked per topic; a route is active when at least one topic is forwarding, and
// the route-level operational_state is derived from these.
enum RouterRouteTopicState {
    TOPIC_IDLE,          // no entities (not discovered, or route not active)
    TOPIC_CREATING,      // prerequisites ready; entity creation in flight
    TOPIC_FORWARDING,    // reader + writer + read condition live
    TOPIC_TEARING_DOWN,  // was forwarding; detach/close in progress
    TOPIC_ERROR          // entity creation/runtime failed; sticky until command re-arm
};

// QoS aliases live on the endpoint spec (input.reader_qos / output.writer_qos) — the
// one canonical location, matching the YAML config schema (D41).
struct RouterRouteTopicSpec {
    string name;
};

struct RouterRouteEndpointSpec {
    string participant;
    string subscriber_partition;
    string publisher_partition;
    string reader_qos;
    string writer_qos;
    string filter_expression;
    sequence<string> filter_parameters;
};

struct RouterRouteSpec {
    string route_name;
    boolean desired_enabled;
    string forwarding_mode;
    RouterRouteEndpointSpec input;
    RouterRouteEndpointSpec output;
    sequence<RouterRouteTopicSpec> topics;
    boolean mirror_instance_state;
    sequence<string> key_fields;
};

struct RouterCommand {
    string target_node;
    string target_router;
    string command_id;
    RouterCommandKind kind;
    string route_name;
    RouterRouteSpec route;
    string payload_json;
};

struct RouterCommandAck {
    string target_node;
    string target_router;
    string command_id;
    string route_name;
    boolean accepted;
    string message;
};

struct RouterRouteTopicStatus {
    string name;
    RouterRouteDiscoveryState discovery_state;   // per-topic rollup of discovery facts
    RouterRouteTopicState topic_state;
    uint64 samples_forwarded;
    uint64 lifecycle_events_forwarded;
    string last_error;
    // Resolved entity QoS, set when entities are built (Phase 5, D39/D45). Empty while
    // no entities exist. The writer summary reflects in-place deadline tightening.
    string reader_qos_summary;
    string writer_qos_summary;
    // Last incompatible-QoS warning ("reader:OWNERSHIP" / "writer:DURABILITY"), from the
    // DDS-native REQUESTED/OFFERED_INCOMPATIBLE_QOS statuses (D39). Warning only — the
    // topic keeps forwarding for whatever DOES match; cleared on rebuild/teardown.
    string qos_warning;
    // Live matched counts from the build's own entities (D64/D66 create-and-observe):
    // input = the route reader's matched publications, output = the route writer's
    // matched subscriptions. 0/0 with TOPIC_FORWARDING = created-but-unmatched.
    uint32 input_matched;
    uint32 output_matched;
    // "input_unmatched" / "output_unmatched" / "input_unmatched,output_unmatched" while
    // a live build has an unmatched leg; empty otherwise. A status reason, NOT a new
    // operational state (D66 — the D2/D11 contract is unchanged).
    string match_reason;
};

struct RouterRouteStatus {
    string route_name;
    RouterRouteSpec desired;
    RouterRouteOperationalState state;           // derived over topic states (D11)
    RouterRouteDiscoveryState discovery_state;   // best (max) topic rollup (D11)
    sequence<RouterRouteTopicStatus> topic_status;
    uint64 state_revision;
    string caused_by_command_id;
    uint64 samples_forwarded;                    // aggregate across topics
    uint64 lifecycle_events_forwarded;           // aggregate across topics
    string last_error;
};

struct RouterParticipantStatus {
    string name;
    int32 domain;
    string participant_partition;
    string qos_profile_alias;
};

struct RouterStatus {
    @key
    string target_node;
    @key
    string target_router;
    string status_id;
    string caused_by_command_id;
    uint64 state_revision;
    sequence<RouterParticipantStatus> participants;
    sequence<RouterRouteStatus> routes;
};

// ---- Presence & Health (Phase 8, D75; sketch: docs/cpp_router/presence-and-health.md) ----
//
// RouterHealth is the ONE liveliness-bearing WAN topic ("RouterHealth"): a compact
// per-router summary, keyed by the router NAME ("<node>/<router>" — the D74/D79
// name-only identity; router_id is retired), heartbeat-written at 1 s with DEADLINE 2 s
// and AUTOMATIC liveliness lease 3 s (the D75-pinned demo numbers; D16 ordering requires
// the WAN participant lease to stay longer than the 3 s liveliness window).
// RouterMeshStatus is the LAN aggregate ("ActRouterMeshStatus"): each router's roster of
// every peer's last summary + presence, republished on roster change.
//
// Deviation from the design-doc sketch (pinned in D76): state_revision is uint64, not
// string — RouterStatus.state_revision is uint64 and the mesh republish trigger ("a
// peer's state_revision advances") compares it numerically.

enum RouterOverallState {
    ROUTER_OK,
    ROUTER_DEGRADED,
    ROUTER_ERROR
};

enum RouterPresenceState {
    PRESENCE_ALIVE,
    PRESENCE_STALE,   // liveliness ok but heartbeats withheld past DEADLINE — policy
                      // flag, never a teardown (D75)
    PRESENCE_DEAD     // liveliness lost / NOT_ALIVE_NO_WRITERS / participant purged
};

// D77: one adjacency edge in the who-sees-who map — which peers this router's roster
// currently tracks, and in what presence state. Compact by design (WAN-frugal, the
// summary-only rule): identity + presence, never the peer's own summary (a WAN
// consumer, e.g. C2, already receives every router's own RouterHealth directly —
// nodes come from the heartbeats, edges from peers_seen; a DEAD edge means "lost this
// peer", no edge means "never saw it").
struct RouterPeerRef {
    string router;         // "<node>/<router>" (name-only identity, D79)
    RouterPresenceState presence;
};

struct RouterHealth {
    @key
    string router;         // "<node>/<router>" — the D74/D79 identity; its node half
                           // replaces the retired node_name field
    string role;           // node role (control/platform)
    string config_hash;    // SHA-256 (full lowercase hex) of the loaded system-wide
                           // config's raw bytes (D80 — C2 sees config drift mesh-wide)
    uint64 heartbeat_seq;
    int64 send_timestamp;  // ns since epoch
    uint64 state_revision; // this router's RouterStatus revision at send time
    uint32 n_routes;
    uint32 n_degraded;
    uint32 n_error;
    RouterOverallState overall_state;
    sequence<RouterPeerRef> peers_seen;  // this router's roster edges (D77)
};

struct RouterMeshPeer {
    RouterHealth health;        // last compact summary heard from the peer
    RouterPresenceState presence;
    int64 last_seen_delta_ms;   // now - last heartbeat receipt, at publish time
};

struct RouterMeshStatus {
    @key
    string observer_node;       // the router publishing this aggregate
    @key
    string observer_router;
    uint64 state_revision;      // bumps when the roster changes
    sequence<RouterMeshPeer> peers;
};

// Keyed by (target_node, target_router) like RouterStatus: each router is one instance
// on ActRouterControllerJournal, so a recorder subscribed to several routers keeps
// per-router reader caches (one router's record burst cannot evict another's). Within a
// single router's instance the stream is still bursty — consumers use KEEP_ALL (D67).
struct ControllerJournalRecord {
    @key
    string target_node;
    @key
    string target_router;
    string status_id;
    uint64 event_sequence;
    int64 timestamp_unix_nanos;
    ControllerJournalEventKind event_kind;
    uint64 pre_state_revision;
    uint64 post_state_revision;
    boolean state_changed;
    string route_name;
    string topic_name;
    string command_id;
    string endpoint_guid;
    uint64 entity_generation;
    string decision;
    string reason;
    string action;
    string payload_json; // compact affected state delta + detailed event fields
};
