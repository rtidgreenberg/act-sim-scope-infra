<?xml version="1.0"?>
<dds>
  <qos_library name="TopicLayout">
    <qos_profile name="participant">
      <domain_participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
          <udpv4>
            <transport_priority_mask>255</transport_priority_mask>
            <transport_priority_mapping_low>0</transport_priority_mapping_low>
            <transport_priority_mapping_high>255</transport_priority_mapping_high>
          </udpv4>
        </transport_builtin>
        <discovery>
          <initial_peers><element>[0-15]@builtin.udpv4://127.0.0.1</element></initial_peers>
          <multicast_receive_addresses/>
        </discovery>
        <discovery_config>
          <builtin_discovery_plugins>SPDP2 | SEDP</builtin_discovery_plugins>
          <request_types_filter>*</request_types_filter>
        </discovery_config>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="endpoint">
      <datawriter_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
        <history><kind>KEEP_ALL_HISTORY_QOS</kind></history>
        <protocol><rtps_reliable_writer>
          <heartbeat_period><sec>1</sec><nanosec>0</nanosec></heartbeat_period>
          <fast_heartbeat_period><sec>1</sec><nanosec>0</nanosec></fast_heartbeat_period>
          <late_joiner_heartbeat_period><sec>1</sec><nanosec>0</nanosec></late_joiner_heartbeat_period>
        </rtps_reliable_writer></protocol>
      </datawriter_qos>
      <datareader_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
        <history><kind>KEEP_ALL_HISTORY_QOS</kind></history>
      </datareader_qos>
    </qos_profile>
    <qos_profile name="reader_suppressed" base_name="TopicLayout::endpoint">
      <datareader_qos>
        <property><value>
          <element>
            <name>dds.data_reader.protocol.disable_preemptive_nack</name>
            <value>true</value>
          </element>
        </value></property>
      </datareader_qos>
    </qos_profile>
    <qos_profile name="class_0" base_name="TopicLayout::endpoint">
      <datawriter_qos><transport_priority><value>0</value></transport_priority></datawriter_qos>
    </qos_profile>
    <qos_profile name="class_1" base_name="TopicLayout::endpoint">
      <datawriter_qos><transport_priority><value>32</value></transport_priority></datawriter_qos>
    </qos_profile>
    <qos_profile name="class_2" base_name="TopicLayout::endpoint">
      <datawriter_qos><transport_priority><value>64</value></transport_priority></datawriter_qos>
    </qos_profile>
    <qos_profile name="class_3" base_name="TopicLayout::endpoint">
      <datawriter_qos><transport_priority><value>96</value></transport_priority></datawriter_qos>
    </qos_profile>
    <qos_profile name="class_4" base_name="TopicLayout::endpoint">
      <datawriter_qos><transport_priority><value>128</value></transport_priority></datawriter_qos>
    </qos_profile>
    <qos_profile name="class_5" base_name="TopicLayout::endpoint">
      <datawriter_qos><transport_priority><value>160</value></transport_priority></datawriter_qos>
    </qos_profile>
  </qos_library>
</dds>
