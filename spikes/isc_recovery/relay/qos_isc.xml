<?xml version="1.0"?>
<!--
  Instance State Consistency (ISC) QoS profile — XML fallback for the Phase 1 PoC.

  The relay/PoC use the Python QoS builders in act_state.py as the source of truth;
  this profile is the equivalent "QoS via XML profile" path the roadmap calls for, and
  is also what Routing Service (rs_config.xml) loads for its own reader/writer.

  Key settings (see act_state.py for the rationale):
    - RELIABLE + RECOVER_INSTANCE_STATE_CONSISTENCY on both ends (enables ISC)
    - TRANSIENT_LOCAL + KEEP_LAST(1) for state-topic last-value + late reconcile
    - writer: autodispose_unregistered_instances=false so unregister -> NO_WRITERS
              (not DISPOSED), and serialize_key_with_dispose=true so a reader can
              recover the key from a dispose-only sample
    - reader: keep_minimum_state_for_instances + propagate_dispose_of_unregistered_instances
              for highest instance-state recovery fidelity
-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.6.0/rti_dds_qos_profiles.xsd">
    <qos_library name="ActIscLibrary">
        <qos_profile name="ActIscProfile" is_default_qos="true">

            <datawriter_qos>
                <reliability>
                    <kind>RELIABLE_RELIABILITY_QOS</kind>
                    <instance_state_consistency_kind>RECOVER_INSTANCE_STATE_CONSISTENCY</instance_state_consistency_kind>
                </reliability>
                <durability>
                    <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
                </durability>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>1</depth>
                </history>
                <writer_data_lifecycle>
                    <autodispose_unregistered_instances>false</autodispose_unregistered_instances>
                </writer_data_lifecycle>
                <protocol>
                    <serialize_key_with_dispose>true</serialize_key_with_dispose>
                </protocol>
            </datawriter_qos>

            <datareader_qos>
                <reliability>
                    <kind>RELIABLE_RELIABILITY_QOS</kind>
                    <instance_state_consistency_kind>RECOVER_INSTANCE_STATE_CONSISTENCY</instance_state_consistency_kind>
                </reliability>
                <durability>
                    <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
                </durability>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>1</depth>
                </history>
                <reader_resource_limits>
                    <keep_minimum_state_for_instances>true</keep_minimum_state_for_instances>
                </reader_resource_limits>
                <protocol>
                    <propagate_dispose_of_unregistered_instances>true</propagate_dispose_of_unregistered_instances>
                </protocol>
            </datareader_qos>

            <participant_qos>
                <transport_builtin>
                    <mask>UDPv4</mask>
                </transport_builtin>
            </participant_qos>

        </qos_profile>
    </qos_library>
</dds>
