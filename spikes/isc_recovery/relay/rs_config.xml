<?xml version="1.0"?>
<!--
  Routing Service config for PoC Path B — "RS defeats ISC" (the LP-1 gap).

  Bridges DOM_B_UP (13) -> DOM_B_DOWN (14) for the ActState topic, so the same source
  and dest apps used by paths A/C can run through a real Routing Service instead of the
  Python relay. RS input-reader and output-writer are configured with the SAME ISC QoS
  the relay uses (qos_isc.xml) — the point being that even when ISC is requested, RS's
  internal input-reader -> output-writer forwarding does NOT carry instance-state
  consistency across the gateway (per RTI docs). So Path B is expected to diverge from
  the direct baseline (A) under disconnect/reconnect, unlike the Python relay (C).

  Run it:
    export NDDSHOME=/home/rti/rti_connext_dds-7.6.0
    export RTI_LICENSE_FILE=$NDDSHOME/rti_license.dat
    rtiroutingservice -cfgFile rs_config.xml -cfgName ActStateBridge

  Types are discovered from the wire (TypeObject), so no IDL/type file is needed for a
  straight topic passthrough.
-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.6.0/rti_routing_service.xsd">

    <!-- Reuse the ISC QoS profile so RS is configured as favorably as possible. -->
    <qos_library name="RsQosLibrary">
        <qos_profile name="RsIscProfile" base_name="ActIscLibrary::ActIscProfile"/>
    </qos_library>

    <routing_service name="ActStateBridge">
        <annotation><documentation>PoC Path B: forward ActState from domain 13 to 14.</documentation></annotation>

        <domain_route name="Dom13to14">
            <participant name="Upstream">
                <domain_id>13</domain_id>
            </participant>
            <participant name="Downstream">
                <domain_id>14</domain_id>
            </participant>

            <session name="Session">
                <topic_route name="ActStateRoute">
                    <input participant="Upstream">
                        <registered_type_name>ActState</registered_type_name>
                        <topic_name>ActState</topic_name>
                        <datareader_qos base_name="ActIscLibrary::ActIscProfile"/>
                    </input>
                    <output participant="Downstream">
                        <registered_type_name>ActState</registered_type_name>
                        <topic_name>ActState</topic_name>
                        <datawriter_qos base_name="ActIscLibrary::ActIscProfile"/>
                    </output>
                </topic_route>
            </session>
        </domain_route>
    </routing_service>
</dds>
