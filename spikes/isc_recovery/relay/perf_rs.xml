<?xml version="1.0"?>
<!-- RS bridge for the perf.py harness: ActState, domain 13 -> 14, throughput QoS
     (RELIABLE + VOLATILE + KEEP_LAST large) matching perf.py's pub/sub/relay. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.6.0/rti_routing_service.xsd">
    <qos_library name="PerfLib">
        <qos_profile name="PerfQos">
            <datareader_qos>
                <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
                <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
                <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>5000</depth></history>
            </datareader_qos>
            <datawriter_qos>
                <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
                <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
                <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>5000</depth></history>
            </datawriter_qos>
        </qos_profile>
    </qos_library>

    <routing_service name="PerfBridge">
        <domain_route name="PerfDomains">
            <participant name="up"><domain_id>13</domain_id></participant>
            <participant name="down"><domain_id>14</domain_id></participant>
            <session name="s">
                <topic_route name="ActStatePerf">
                    <input participant="up">
                        <topic_name>PerfState</topic_name>
                        <registered_type_name>ActState</registered_type_name>
                        <datareader_qos base_name="PerfLib::PerfQos"/>
                    </input>
                    <output participant="down">
                        <topic_name>PerfState</topic_name>
                        <registered_type_name>ActState</registered_type_name>
                        <datawriter_qos base_name="PerfLib::PerfQos"/>
                    </output>
                </topic_route>
            </session>
        </domain_route>
    </routing_service>
</dds>
