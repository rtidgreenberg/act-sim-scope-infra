<?xml version="1.0"?>
<dds>
  <types>
    <struct name="TradeoffSample">
      <member name="source" type="string" stringMaxLength="32"/>
      <member name="flow" type="string" stringMaxLength="32"/>
      <member name="phase" type="string" stringMaxLength="32"/>
      <member name="session" type="string" stringMaxLength="32"/>
      <member name="sequence" type="uint64"/>
      <member name="payload" type="string" stringMaxLength="256"/>
    </struct>
  </types>
  <qos_library name="Tradeoffs">
    <qos_profile name="participant" base_name="BuiltinQosLib::Generic.Common">
      <domain_participant_qos>
        <transport_builtin><mask>UDPv4</mask></transport_builtin>
        <property>
          <value>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>127.0.0.1</value>
            </element>
          </value>
        </property>
        <discovery>
          <initial_peers><element>96@127.0.0.1</element></initial_peers>
          <multicast_receive_addresses/>
        </discovery>
        <discovery_config>
          <builtin_discovery_plugins>SPDP2 | SEDP</builtin_discovery_plugins>
          <initial_participant_announcements>3</initial_participant_announcements>
          <participant_liveliness_assert_period><sec>30</sec><nanosec>0</nanosec></participant_liveliness_assert_period>
          <participant_liveliness_lease_duration><sec>100</sec><nanosec>0</nanosec></participant_liveliness_lease_duration>
        </discovery_config>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="sample" base_name="BuiltinQosLib::Generic.Common">
      <datawriter_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>64</depth></history>
      </datawriter_qos>
      <datareader_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>64</depth></history>
      </datareader_qos>
    </qos_profile>
    <qos_profile name="probe" base_name="Tradeoffs::sample">
      <datawriter_qos>
        <reliability><acknowledgment_kind>APPLICATION_AUTO_ACKNOWLEDGMENT_MODE</acknowledgment_kind></reliability>
      </datawriter_qos>
      <datareader_qos>
        <reliability><acknowledgment_kind>APPLICATION_AUTO_ACKNOWLEDGMENT_MODE</acknowledgment_kind></reliability>
      </datareader_qos>
    </qos_profile>
    <qos_profile name="scale_participant" base_name="Tradeoffs::participant">
      <domain_participant_qos>
        <discovery_config><request_types_filter>*</request_types_filter></discovery_config>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="scale_participant_spdp" base_name="Tradeoffs::scale_participant">
      <domain_participant_qos>
        <discovery_config>
          <builtin_discovery_plugins>SPDP | SEDP</builtin_discovery_plugins>
        </discovery_config>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="scale_periodic" base_name="Tradeoffs::sample">
      <datawriter_qos>
        <reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability>
      </datawriter_qos>
      <datareader_qos>
        <reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability>
      </datareader_qos>
    </qos_profile>
    <qos_profile name="scale_health30" base_name="Tradeoffs::scale_periodic">
      <datawriter_qos>
        <durability><kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind></durability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
        <deadline><period><sec>2</sec><nanosec>0</nanosec></period></deadline>
        <liveliness>
          <kind>AUTOMATIC_LIVELINESS_QOS</kind>
          <lease_duration><sec>30</sec><nanosec>0</nanosec></lease_duration>
        </liveliness>
      </datawriter_qos>
      <datareader_qos>
        <durability><kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind></durability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
        <deadline><period><sec>2</sec><nanosec>0</nanosec></period></deadline>
        <liveliness>
          <kind>AUTOMATIC_LIVELINESS_QOS</kind>
          <lease_duration><sec>30</sec><nanosec>0</nanosec></lease_duration>
        </liveliness>
      </datareader_qos>
    </qos_profile>
  </qos_library>
</dds>
