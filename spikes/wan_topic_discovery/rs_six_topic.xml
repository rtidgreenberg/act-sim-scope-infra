            <topic_name>WAN_P2_State</topic_name>
            <registered_type_name>SixTopicState</registered_type_name>
            <creation_mode>IMMEDIATE</creation_mode>
            <datawriter_qos base_name="RS_SIX::wan_p2_state"/>
          </output>
        </topic_route>

        <topic_route name="p2_periodic">
          <input participant="lan">
            <topic_name>LAN_P2_Periodic</topic_name>
            <registered_type_name>SixTopicPeriodic</registered_type_name>
            <creation_mode>IMMEDIATE</creation_mode>
            <datareader_qos base_name="RS_SIX::lan_periodic"/>
          </input>
          <output participant="wan">
            <topic_name>WAN_P2_Periodic</topic_name>
            <registered_type_name>SixTopicPeriodic</registered_type_name>
            <creation_mode>IMMEDIATE</creation_mode>
            <datawriter_qos base_name="RS_SIX::wan_p2_periodic"/>
          </output>
        </topic_route>

        <topic_route name="p3_periodic">
          <input participant="lan">
            <topic_name>LAN_P3_Periodic</topic_name>
            <registered_type_name>SixTopicPeriodic</registered_type_name>
            <creation_mode>IMMEDIATE</creation_mode>
