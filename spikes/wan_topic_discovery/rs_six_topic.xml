        <topic_route name="p3_periodic">
          <input participant="wan">
            <topic_name>WAN_P3_Periodic</topic_name>
            <registered_type_name>SixTopicPeriodic</registered_type_name>
            <creation_mode>IMMEDIATE</creation_mode>
            <datareader_qos base_name="RS_SIX::wan_p3_periodic"/>
          </input>
          <output participant="lan">
            <topic_name>LAN_P3_Periodic</topic_name>
            <registered_type_name>SixTopicPeriodic</registered_type_name>
            <creation_mode>IMMEDIATE</creation_mode>
            <datawriter_qos base_name="RS_SIX::lan_periodic"/>
          </output>
        </topic_route>
      </session>
    </domain_route>
  </routing_service>
</dds>
