            <registered_type_name>SixTopicPeriodic</registered_type_name>
            <creation_mode>IMMEDIATE</creation_mode>
            <datawriter_qos base_name="RS_SIX::wan_p3_periodic"/>
          </output>
        </topic_route>
      </session>
    </domain_route>
  </routing_service>

