<dds>
  <configuration_variables>
    <value>
      <element><name>WAN_PEER</name><value>10.88.0.2</value></element>
      <element><name>TOS_P1</name><value>192</value></element>
      <element><name>TOS_P2</name><value>136</value></element>
      <element><name>TOS_P3</name><value>104</value></element>
    </value>
  </configuration_variables>
  <qos_library name="RS_SIX">
    <qos_profile name="base_v4">
      <domain_participant_qos>
        <discovery><multicast_receive_addresses/></discovery>
        <discovery_config><builtin_discovery_plugins>SPDP2 | SEDP</builtin_discovery_plugins></discovery_config>
        <transport_builtin><mask>UDPv4</mask></transport_builtin>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="lan_v4" base_name="RS_SIX::base_v4">
      <domain_participant_qos>
        <transport_builtin><udpv4>
          <ignore_loopback_interface>0</ignore_loopback_interface>
        </udpv4></transport_builtin>
        <discovery><initial_peers><element>[0-15]@builtin.udpv4://127.0.0.1</element></initial_peers></discovery>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="emane_v4" base_name="RS_SIX::base_v4">
      <domain_participant_qos>
        <transport_builtin><udpv4>
          <ignore_loopback_interface>1</ignore_loopback_interface>
          <allow_interfaces_list><element>emane0</element></allow_interfaces_list>
          <transport_priority_mask>255</transport_priority_mask>
          <transport_priority_mapping_low>0</transport_priority_mapping_low>
          <transport_priority_mapping_high>255</transport_priority_mapping_high>
        </udpv4></transport_builtin>
        <discovery><initial_peers><element>[0-15]@builtin.udpv4://$(WAN_PEER)</element></initial_peers></discovery>
      </domain_participant_qos>
    </qos_profile>

    <!-- Event: RELIABLE, KEEP_ALL -->
    <qos_profile name="event_base">
      <datawriter_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_ALL_HISTORY_QOS</kind></history>
      </datawriter_qos>
      <datareader_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_ALL_HISTORY_QOS</kind></history>
      </datareader_qos>
    </qos_profile>

    <!-- State: RELIABLE, writer KEEP_LAST(1) per key, reader KEEP_ALL -->
    <qos_profile name="state_base">
      <datawriter_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
      </datawriter_qos>
      <datareader_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_ALL_HISTORY_QOS</kind></history>
      </datareader_qos>
    </qos_profile>

    <!-- Periodic: BEST_EFFORT, KEEP_LAST(1) -->
    <qos_profile name="periodic_base">
      <datawriter_qos>
        <reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
      </datawriter_qos>
      <datareader_qos>
        <reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
      </datareader_qos>
    </qos_profile>

    <!-- LAN reader/writer profiles (keep_all on test consumer so no burst drops on LAN) -->
    <qos_profile name="lan_event" base_name="RS_SIX::event_base"/>
    <qos_profile name="lan_state" base_name="RS_SIX::state_base"/>
    <qos_profile name="lan_periodic" base_name="RS_SIX::periodic_base">
      <datareader_qos>
        <history><kind>KEEP_ALL_HISTORY_QOS</kind></history>
      </datareader_qos>
    </qos_profile>

    <!-- Six WAN topic profiles: P1 (CS6=48 -> 192), P2 (AF41=34 -> 136), P3 (AF31=26 -> 104) -->
    <qos_profile name="wan_p1_event" base_name="RS_SIX::event_base">
      <datawriter_qos><transport_priority><value>$(TOS_P1)</value></transport_priority></datawriter_qos>
    </qos_profile>
    <qos_profile name="wan_p1_periodic" base_name="RS_SIX::periodic_base">
      <datawriter_qos><transport_priority><value>$(TOS_P1)</value></transport_priority></datawriter_qos>
    </qos_profile>
    <qos_profile name="wan_p2_event" base_name="RS_SIX::event_base">
      <datawriter_qos><transport_priority><value>$(TOS_P2)</value></transport_priority></datawriter_qos>
    </qos_profile>
    <qos_profile name="wan_p2_state" base_name="RS_SIX::state_base">
      <datawriter_qos><transport_priority><value>$(TOS_P2)</value></transport_priority></datawriter_qos>
    </qos_profile>
    <qos_profile name="wan_p2_periodic" base_name="RS_SIX::periodic_base">
      <datawriter_qos><transport_priority><value>$(TOS_P2)</value></transport_priority></datawriter_qos>
    </qos_profile>
    <qos_profile name="wan_p3_periodic" base_name="RS_SIX::periodic_base">
      <datawriter_qos><transport_priority><value>$(TOS_P3)</value></transport_priority></datawriter_qos>
    </qos_profile>
  </qos_library>
</dds>
