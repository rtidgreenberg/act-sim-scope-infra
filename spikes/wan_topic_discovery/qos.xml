<dds>
  <configuration_variables>
    <value><element><name>PROBE_PEER</name><value>::1</value></element></value>
  </configuration_variables>
  <qos_library name="SPIKE">
    <qos_profile name="base">
      <domain_participant_qos>
        <discovery><multicast_receive_addresses/></discovery>
        <discovery_config><builtin_discovery_plugins>SPDP2 | SEDP</builtin_discovery_plugins></discovery_config>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="v4" base_name="SPIKE::base">
      <domain_participant_qos>
        <transport_builtin><mask>UDPv4</mask></transport_builtin>
        <discovery><initial_peers><element>[0-6]@builtin.udpv4://127.0.0.1</element></initial_peers></discovery>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="v6" base_name="SPIKE::base">
      <domain_participant_qos>
        <transport_builtin>
          <mask>UDPv6</mask>
          <udpv6>
            <ignore_loopback_interface>0</ignore_loopback_interface>
            <transport_priority_mask>255</transport_priority_mask>
            <transport_priority_mapping_low>0</transport_priority_mapping_low>
            <transport_priority_mapping_high>255</transport_priority_mapping_high>
          </udpv6>
        </transport_builtin>
        <discovery><initial_peers><element>[0-6]@builtin.udpv6://::1</element></initial_peers></discovery>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="emane_v6" base_name="SPIKE::v6">
      <domain_participant_qos>
        <transport_builtin><udpv6>
          <ignore_loopback_interface>1</ignore_loopback_interface>
          <allow_interfaces_list><element>emane0</element></allow_interfaces_list>
        </udpv6></transport_builtin>
        <discovery><initial_peers><element>[0]@builtin.udpv6://$(PROBE_PEER)</element></initial_peers></discovery>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="event">
      <datawriter_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_ALL_HISTORY_QOS</kind></history>
      </datawriter_qos>
      <datareader_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <history><kind>KEEP_ALL_HISTORY_QOS</kind></history>
        <property><value><element>
          <name>dds.data_reader.protocol.disable_preemptive_nack</name><value>true</value>
        </element></value></property>
      </datareader_qos>
    </qos_profile>
    <qos_profile name="state" base_name="SPIKE::event">
      <datawriter_qos><history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history></datawriter_qos>
    </qos_profile>
    <qos_profile name="periodic">
      <datawriter_qos><reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability></datawriter_qos>
      <datareader_qos><reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability></datareader_qos>
    </qos_profile>
    <qos_profile name="normal" base_name="SPIKE::periodic">
      <datawriter_qos><transport_priority><value>0</value></transport_priority></datawriter_qos>
    </qos_profile>
    <qos_profile name="emane_probe_reader" base_name="SPIKE::periodic">
      <datareader_qos><history><kind>KEEP_ALL_HISTORY_QOS</kind></history></datareader_qos>
    </qos_profile>
    <qos_profile name="high" base_name="SPIKE::periodic">
      <datawriter_qos><transport_priority><value>184</value></transport_priority></datawriter_qos>
    </qos_profile>
  </qos_library>
</dds>
