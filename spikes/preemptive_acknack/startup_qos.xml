<?xml version="1.0"?>
<dds>
  <qos_library name="STARTUP">
    <qos_profile name="base">
      <domain_participant_qos>
        <transport_builtin><mask>UDPv4</mask></transport_builtin>
        <discovery>
          <initial_peers>
            <element>[0-7]@builtin.udpv4://127.0.0.1</element>
          </initial_peers>
          <multicast_receive_addresses/>
        </discovery>
        <property><value><element>
          <name>dds.participant.inter_participant_data_reader.protocol.disable_preemptive_nack</name>
          <value>false</value>
        </element></value></property>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="spdp_off" base_name="STARTUP::base">
      <domain_participant_qos>
        <discovery_config><builtin_discovery_plugins>SPDP | SEDP</builtin_discovery_plugins></discovery_config>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="spdp_on" base_name="STARTUP::spdp_off">
      <domain_participant_qos>
        <property><value><element>
          <name>dds.participant.inter_participant_data_reader.protocol.disable_preemptive_nack</name>
          <value>true</value>
        </element></value></property>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="spdp2_off" base_name="STARTUP::base">
      <domain_participant_qos>
        <discovery_config><builtin_discovery_plugins>SPDP2 | SEDP</builtin_discovery_plugins></discovery_config>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="spdp2_on" base_name="STARTUP::spdp2_off">
      <domain_participant_qos>
        <property><value><element>
          <name>dds.participant.inter_participant_data_reader.protocol.disable_preemptive_nack</name>
          <value>true</value>
        </element></value></property>
      </domain_participant_qos>
    </qos_profile>
  </qos_library>
</dds>
