    <struct name="SpikeModeCommand">
      <member name="command_id" type="string" stringMaxLength="64" key="true"/>
      <member name="destination" type="string" stringMaxLength="64"/>
      <member name="sequence" type="unsignedLong"/>
      <member name="issued_at" type="longLong"/>
      <member name="mode" type="string" stringMaxLength="64"/>
      <member name="enabled" type="boolean"/>
      <member name="arguments" type="long" sequenceMaxLength="8"/>
    </struct>
  </types>
</dds>
