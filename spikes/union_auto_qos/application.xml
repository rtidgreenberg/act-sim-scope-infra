<?xml version="1.0"?>
<dds>
  <types>
    <struct name="UaqPoint">
      <member name="north" type="double"/>
      <member name="east" type="double"/>
    </struct>
    <struct name="UaqCommand">
      <member name="id" type="string" stringMaxLength="64" key="true"/>
      <member name="audit_sequence" type="unsignedLong"/>
      <member name="timestamp" type="longLong"/>
      <member name="destination" type="string" stringMaxLength="64"/>
      <member name="points" type="nonBasic" nonBasicTypeName="UaqPoint" sequenceMaxLength="8"/>
      <member name="limits" type="double" arrayDimensions="3"/>
    </struct>
    <struct name="UaqStatus">
      <member name="id" type="string" stringMaxLength="64" key="true"/>
      <member name="audit_sequence" type="unsignedLong"/>
      <member name="timestamp" type="longLong"/>
      <member name="position" type="nonBasic" nonBasicTypeName="UaqPoint"/>
      <member name="history" type="nonBasic" nonBasicTypeName="UaqPoint" sequenceMaxLength="8"/>
      <member name="motors" type="long" arrayDimensions="4"/>
      <member name="note" type="string" stringMaxLength="128"/>
    </struct>
  </types>
</dds>
