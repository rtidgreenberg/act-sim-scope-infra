# rtiddsgen-generated C++ code (router/CMakeLists.txt generates these at build time into
# a build/ dir via connextdds_rtiddsgen_run; harness_v2/datamodel/ActTypes.idl is the
# single source of truth — never commit stray manual `rtiddsgen` C++ output).
# The XML conversion (harness_v2/datamodel/gen/ActTypes.xml) IS committed.
harness_v2/datamodel/ActTypes*.cxx
harness_v2/datamodel/ActTypes*.h

