    <!-- Three-topic Routing Service writers: physical Event, State and Periodic.
         Zlib applies only to these writers and their six-topic descendants. -->
    <qos_profile name="rs_three_topic_event" base_name="ACT_QOS_LIB::wan_three_topic_event">
      <datawriter_qos>
        <representation>
          <compression_settings>
            <compression_ids>ZLIB</compression_ids>
            <writer_compression_level>BEST_SPEED</writer_compression_level>
            <writer_compression_threshold>0</writer_compression_threshold>
