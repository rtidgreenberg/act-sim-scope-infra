            <element><filter_expression>@priority &lt; 300</filter_expression><priority>-1</priority><multicast_settings/></element>
          </channels>
        </multi_channel>
      </datawriter_qos>
    </qos_profile>

    <qos_profile name="rs_three_topic_periodic" base_name="ACT_QOS_LIB::wan_union_periodic">
      <datawriter_qos>
        <representation>
          <compression_settings>
            <compression_ids>ZLIB</compression_ids>
            <writer_compression_level>BEST_SPEED</writer_compression_level>
            <writer_compression_threshold>0</writer_compression_threshold>
          </compression_settings>
        </representation>
        <publish_mode>
          <kind>ASYNCHRONOUS_PUBLISH_MODE_QOS</kind>
          <flow_controller_name>dds.flow_controller.token_bucket.act_rs</flow_controller_name>
          <priority>-1</priority>
        </publish_mode>
        <multi_channel>
          <filter_name>DDSPRIFLTR</filter_name>
          <channels>
            <element><filter_expression>@priority &gt;= 400</filter_expression><priority>-1</priority><multicast_settings/></element>
            <element><filter_expression>@priority &lt; 400</filter_expression><priority>-1</priority><multicast_settings/></element>
          </channels>
        </multi_channel>
      </datawriter_qos>
