    <!-- Runtime Routing Service controller shared by all WAN writer families.
         Default allowance: 5000 bytes per 10 ms (4 Mbps), not RF airtime. -->
    <qos_profile name="rs_priority_participant">
      <domain_participant_qos>
        <resource_limits>
          <participant_property_list_max_length>64</participant_property_list_max_length>
        </resource_limits>
        <property>
          <value>
            <element>
              <name>dds.flow_controller.token_bucket.act_rs.scheduling_policy</name>
              <value>DDS_HPF_FLOW_CONTROLLER_SCHED_POLICY</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.act_rs.token_bucket.max_tokens</name>
              <value>1</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.act_rs.token_bucket.tokens_added_per_period</name>
              <value>1</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.act_rs.token_bucket.tokens_leaked_per_period</name>
              <value>0</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.act_rs.token_bucket.bytes_per_token</name>
              <value>$(RS_FLOW_BYTES_PER_PERIOD)</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.act_rs.token_bucket.period.sec</name>
              <value>0</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.act_rs.token_bucket.period.nanosec</name>
              <value>10000000</value>
            </element>
          </value>
        </property>
      </domain_participant_qos>
    </qos_profile>

    <!-- Two-topic Routing Service writers: physical Event and Status. -->
    <qos_profile name="rs_wan_event" base_name="ACT_QOS_LIB::wan_event">
      <datawriter_qos>
        <publish_mode>
          <kind>ASYNCHRONOUS_PUBLISH_MODE_QOS</kind>
          <flow_controller_name>dds.flow_controller.token_bucket.act_rs</flow_controller_name>
          <priority>-1</priority>
        </publish_mode>
        <multi_channel>
          <filter_name>DDSPRIFLTR</filter_name>
          <channels>
            <element>
              <filter_expression>@priority &gt;= 300</filter_expression>
              <priority>-1</priority>
              <multicast_settings/>
            </element>
            <element>
              <filter_expression>@priority &lt; 300</filter_expression>
              <priority>-1</priority>
              <multicast_settings/>
            </element>
          </channels>
        </multi_channel>
      </datawriter_qos>
    </qos_profile>

    <qos_profile name="rs_wan_periodic" base_name="ACT_QOS_LIB::wan_union_periodic">
