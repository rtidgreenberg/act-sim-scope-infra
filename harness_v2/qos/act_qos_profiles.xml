    <!-- Six-topic runtime UDPv6 participant and writers:
         P1_Event/P1_Periodic, P2_Event/P2_State/P2_Periodic, P3_Periodic.
         DSCP markings: CS6=48, AF41=34, AF31=26. -->
    <qos_profile name="rs_six_topic_participant_v6" base_name="ACT_QOS_LIB::wan_router_participant">
      <domain_participant_qos>
        <resource_limits>
          <contentfilter_property_max_length>16384</contentfilter_property_max_length>
          <participant_property_list_max_length>64</participant_property_list_max_length>
        </resource_limits>
        <transport_builtin>
          <mask>UDPv6</mask>
          <udpv6>
            <transport_priority_mask>255</transport_priority_mask>
            <transport_priority_mapping_low>0</transport_priority_mapping_low>
            <transport_priority_mapping_high>255</transport_priority_mapping_high>
          </udpv6>
        </transport_builtin>
        <discovery>
          <initial_peers>
            <element>[0-15]@builtin.udpv6://$(WAN_PEER_V6)</element>
            <element>[0-15]@builtin.udpv6://$(WAN_PEER_V6_2)</element>
            <element>[0-15]@builtin.udpv6://$(WAN_PEER_V6_3)</element>
            <element>[0-15]@builtin.udpv6://$(WAN_PEER_V6_4)</element>
            <element>[0-15]@builtin.udpv6://$(WAN_PEER_V6_5)</element>
            <element>[0-15]@builtin.udpv6://$(WAN_PEER_V6_6)</element>
            <element>[0-15]@builtin.udpv6://$(WAN_PEER_V6_7)</element>
            <element>[0-15]@builtin.udpv6://$(WAN_PEER_V6_8)</element>
            <element>[0-15]@builtin.udpv6://$(WAN_PEER_V6_9)</element>
            <element>[0-15]@builtin.udpv6://$(WAN_PEER_V6_10)</element>
            <element>[0-15]@builtin.udpv6://$(WAN_PEER_V6_11)</element>
          </initial_peers>
        </discovery>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="rs_six_topic_participant_emane_v6" base_name="ACT_QOS_LIB::rs_six_topic_participant_v6">
      <domain_participant_qos>
        <transport_builtin>
          <udpv6>
            <ignore_loopback_interface>1</ignore_loopback_interface>
            <allow_interfaces_list>
              <element>emane0</element>
            </allow_interfaces_list>
          </udpv6>
        </transport_builtin>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="rs_six_topic_p1_event" base_name="ACT_QOS_LIB::rs_three_topic_event">
      <datawriter_qos>
        <transport_priority><value>192</value></transport_priority>
        <multi_channel>
          <filter_name>DDSPRIFLTR</filter_name>
          <channels>
            <element><filter_expression>@priority &gt;= 600</filter_expression><priority>-1</priority><multicast_settings/></element>
            <element><filter_expression>@priority &lt; 600</filter_expression><priority>-1</priority><multicast_settings/></element>
          </channels>
        </multi_channel>
      </datawriter_qos>
    </qos_profile>

    <qos_profile name="rs_six_topic_p1_periodic" base_name="ACT_QOS_LIB::rs_three_topic_periodic">
      <datawriter_qos>
        <transport_priority><value>192</value></transport_priority>
        <multi_channel>
          <filter_name>DDSPRIFLTR</filter_name>
          <channels>
            <element><filter_expression>@priority &gt;= 600</filter_expression><priority>-1</priority><multicast_settings/></element>
            <element><filter_expression>@priority &lt; 600</filter_expression><priority>-1</priority><multicast_settings/></element>
