<?xml version="1.0"?>

<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="http://community.rti.com/schema/7.3.0/rti_dds_qos_profiles.xsd">

  <!--
    Production runtime profiles for the custom router and native Routing Service.
    Keep shared bases and legacy/two-topic, three-topic and six-topic policies here.
    Test overrides and experimental discovery/compression profiles belong in
    test fixtures or spikes, not in this production library.
  -->

  <configuration_variables>
    <element>
      <name>ACT_PARTICIPANT_NAME</name>
      <value>act-process</value>
    </element>
    <element>
      <name>ACT_PARTICIPANT_ROLE</name>
      <value>act.process</value>
    </element>
    <element>
      <name>CONTROL_LAN_PEER1</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>CONTROL_LAN_PEER2</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>CONTROL_LAN_PEER3</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>PLATFORM_LAN_PEER1</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>PLATFORM_LAN_PEER2</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>PLATFORM_LAN_PEER3</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER2</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER3</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER4</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER5</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER6</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER7</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER8</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER9</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER10</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER11</name>
      <value>127.0.0.1</value>
    </element>
    <element>
      <name>WAN_PEER_V6</name>
      <value>::1</value>
    </element>
    <element>
      <name>WAN_PEER_V6_2</name>
      <value>::1</value>
    </element>
    <element>
      <name>WAN_PEER_V6_3</name>
      <value>::1</value>
    </element>
    <element>
      <name>WAN_PEER_V6_4</name>
      <value>::1</value>
    </element>
    <element>
      <name>WAN_PEER_V6_5</name>
      <value>::1</value>
    </element>
    <element>
      <name>WAN_PEER_V6_6</name>
      <value>::1</value>
    </element>
    <element>
      <name>WAN_PEER_V6_7</name>
      <value>::1</value>
    </element>
    <element>
      <name>WAN_PEER_V6_8</name>
      <value>::1</value>
    </element>
    <element>
      <name>WAN_PEER_V6_9</name>
      <value>::1</value>
    </element>
    <element>
      <name>WAN_PEER_V6_10</name>
      <value>::1</value>
    </element>
    <element>
      <name>WAN_PEER_V6_11</name>
      <value>::1</value>
    </element>
    <element>
      <name>WAN_HB_RETRIES</name>
      <value>100</value>
    </element>
    <element>
      <name>WAN_RECEIVE_MULTICAST</name>
      <value>0</value>
    </element>
    <element>
      <name>WAN_TTL</name>
      <value>6</value>
    </element>
    <element>
      <name>WAN_HB_PERIOD_SEC</name>
      <value>3</value>
    </element>
    <element>
      <name>WAN_TIMEOUT_SEC</name>
      <value>300</value>
    </element>
    <element>
      <name>WAN_MAX_BLOCKING_SEC</name>
      <value>15</value>
    </element>
    <element>
      <name>RS_FLOW_BYTES_PER_PERIOD</name>
      <value>5000</value>
    </element>
  </configuration_variables>

  <qos_library name="ACT_QOS_LIB">
    <!-- Shared participant discovery and LAN transport bases. -->
    <qos_profile name="participant_discovery_base">
      <domain_participant_qos>
        <discovery_config>
          <!-- Disable RTPX tool announcements, not ordinary domain discovery. -->
          <default_domain_announcement_period>
            <sec>DURATION_INFINITE_SEC</sec>
            <nanosec>DURATION_INFINITE_NSEC</nanosec>
          </default_domain_announcement_period>
        </discovery_config>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="lan_participant_base"
                 base_name="ACT_QOS_LIB::participant_discovery_base">
      <domain_participant_qos>
        <transport_builtin>
          <udpv4>
            <deny_interfaces_list>
              <element>emane0</element>
            </deny_interfaces_list>
          </udpv4>
        </transport_builtin>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="router_journal_participant"
                 base_name="ACT_QOS_LIB::lan_participant_base">
      <domain_participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
      </domain_participant_qos>
    </qos_profile>

    <!-- LAN participant and application endpoint policies. -->

    <qos_profile name="lan_transport_loopback" base_name="ACT_QOS_LIB::lan_participant_base">
      <domain_participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
          <udpv4>
            <allow_interfaces_list>
              <element>127.0.0.1</element>
            </allow_interfaces_list>
          </udpv4>
        </transport_builtin>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="lan_router_participant" base_name="ACT_QOS_LIB::lan_transport_loopback">
      <domain_participant_qos>
        <discovery_config>
          <request_types_filter>*</request_types_filter>
        </discovery_config>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="lan_control_router_participant" base_name="ACT_QOS_LIB::lan_participant_base">
      <domain_participant_qos>
        <discovery_config>
          <request_types_filter>*</request_types_filter>
        </discovery_config>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="lan_platform_participant" base_name="ACT_QOS_LIB::lan_transport_loopback">

      <domain_participant_qos>
        <participant_name>
          <name>$(ACT_PARTICIPANT_NAME)</name>
          <role_name>$(ACT_PARTICIPANT_ROLE)</role_name>
        </participant_name>

        <!-- Match QoS in your Platform LAN -->

        <discovery>
          <initial_peers>
            <element>$(PLATFORM_LAN_PEER1)</element>
            <element>$(PLATFORM_LAN_PEER2)</element>
            <element>$(PLATFORM_LAN_PEER3)</element>
          </initial_peers>
        </discovery>

      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="lan_control_participant" base_name="ACT_QOS_LIB::lan_participant_base">
      <domain_participant_qos>
        <participant_name>
          <name>$(ACT_PARTICIPANT_NAME)</name>
          <role_name>$(ACT_PARTICIPANT_ROLE)</role_name>
        </participant_name>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="lan_status" base_name="BuiltinQosLib::Generic.Common">
      <!-- LAN periodic data; deadline and liveliness remain infinite. -->

      <datawriter_qos>
        <!-- Messages are sent once, does NOT ensure delivery -->
        <reliability>
          <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
        </reliability>

        <!-- Retain only the latest sample per instance on the writer. -->
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>

      </datawriter_qos>

      <datareader_qos>

        <!-- Messages are sent once, does NOT ensure delivery -->
        <reliability>
          <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
        </reliability>

        <!-- Retain up to 50 samples per instance on the reader. -->
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>50</depth>
        </history>

      </datareader_qos>
    </qos_profile>

    <qos_profile name="lan_status_1s" base_name="ACT_QOS_LIB::lan_status">

      <datareader_qos>
        <!-- Downsample periodic LAN input before routing. -->
        <time_based_filter>
          <minimum_separation>
            <sec>1</sec>
            <nanosec>0</nanosec>
          </minimum_separation>
        </time_based_filter>
      </datareader_qos>

    </qos_profile>


    <qos_profile name="lan_event" base_name="BuiltinQosLib::Generic.Common">
      <!-- Update here per an Aperiodic Command Data Pattern/your system -->
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>
      </datawriter_qos>

      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>
      </datareader_qos>

    </qos_profile>

    <!-- WAN participant policies and custom-router flow control. -->

    <qos_profile name="wan_router_participant_base" base_name="ACT_QOS_LIB::participant_discovery_base">

      <!-- Shared WAN discovery/transport base, validated with Connext 7.7.0. -->
      <domain_participant_qos>


        <!-- Minimizes participant discovery packets -->
        <base_name>
          <element>BuiltinQosSnippetLib::Optimization.Discovery.Participant.Compact</element>
        </base_name>

        <transport_builtin>
          <!-- Select only the UDP transport/ Disable SHMEM -->
          <mask>UDPv4</mask>

          <!-- Set Multicast TTL -->
          <udpv4>
            <multicast_ttl>$(WAN_TTL)</multicast_ttl>
          </udpv4>
        </transport_builtin>


        <discovery_config>
          <builtin_discovery_plugins>SPDP2 | SEDP</builtin_discovery_plugins>

          <!-- Router WAN legs create DynamicData routes from discovered TypeObjects. -->
          <request_types_filter>*</request_types_filter>

          <!-- 
            Defines amount of messages broadcast on startup to announce a participants presence. 
            DEFAULT: 5.
            This can cause issues when many participants are "announcing" themselves at the same time. 
            -->
          <initial_participant_announcements>3</initial_participant_announcements>

          <!-- 
            Adjust how often applications will assert their presence here per requirements
            These are very lightweight messages but period can be extended to optimize network usage.
            DEFAULT: 30 secs 
            -->
          <participant_liveliness_assert_period>
            <sec>30</sec>
            <nanosec>0</nanosec>
          </participant_liveliness_assert_period>

          <!-- 
            Discovery lease from the WAN system timeout, default 300 seconds.
            Keep it longer than participant_liveliness_assert_period.
            -->
          <participant_liveliness_lease_duration>
            <sec>$(WAN_TIMEOUT_SEC)</sec>
            <nanosec>0</nanosec>
          </participant_liveliness_lease_duration>

          <!-- Adjust Discovery Heartbeat per RTT of WAN network -->
          <publication_writer>
            <low_watermark>0</low_watermark>
            <high_watermark>1</high_watermark>
            <heartbeat_period>
              <sec>$(WAN_HB_PERIOD_SEC)</sec>
              <nanosec>0</nanosec>
            </heartbeat_period>
            <fast_heartbeat_period>
              <sec>$(WAN_HB_PERIOD_SEC)</sec>
              <nanosec>0</nanosec>
            </fast_heartbeat_period>
            <late_joiner_heartbeat_period>
              <sec>$(WAN_HB_PERIOD_SEC)</sec>
              <nanosec>0</nanosec>
            </late_joiner_heartbeat_period>
            <max_heartbeat_retries>$(WAN_HB_RETRIES)</max_heartbeat_retries>
            <heartbeats_per_max_samples>0</heartbeats_per_max_samples>
            <min_nack_response_delay>
              <sec>0</sec>
              <nanosec>0</nanosec>
            </min_nack_response_delay>
            <max_nack_response_delay>
              <sec>0</sec>
              <nanosec>0</nanosec>
            </max_nack_response_delay>
          </publication_writer>
          <subscription_writer>
            <low_watermark>0</low_watermark>
            <high_watermark>1</high_watermark>
            <heartbeat_period>
              <sec>$(WAN_HB_PERIOD_SEC)</sec>
              <nanosec>0</nanosec>
            </heartbeat_period>
            <fast_heartbeat_period>
              <sec>$(WAN_HB_PERIOD_SEC)</sec>
              <nanosec>0</nanosec>
            </fast_heartbeat_period>
            <late_joiner_heartbeat_period>
              <sec>$(WAN_HB_PERIOD_SEC)</sec>
              <nanosec>0</nanosec>
            </late_joiner_heartbeat_period>
            <max_heartbeat_retries>1000</max_heartbeat_retries>
            <heartbeats_per_max_samples>0</heartbeats_per_max_samples>
            <min_nack_response_delay>
              <sec>0</sec>
              <nanosec>0</nanosec>
            </min_nack_response_delay>
            <max_nack_response_delay>
              <sec>0</sec>
              <nanosec>0</nanosec>
            </max_nack_response_delay>
          </subscription_writer>
          <publication_reader>
            <min_heartbeat_response_delay>
              <sec>0</sec>
              <nanosec>0</nanosec>
            </min_heartbeat_response_delay>
            <max_heartbeat_response_delay>
              <sec>1</sec>
              <nanosec>0</nanosec>
            </max_heartbeat_response_delay>
          </publication_reader>
          <subscription_reader>
            <min_heartbeat_response_delay>
              <sec>0</sec>
              <nanosec>0</nanosec>
            </min_heartbeat_response_delay>
            <max_heartbeat_response_delay>
              <sec>1</sec>
              <nanosec>0</nanosec>
            </max_heartbeat_response_delay>
          </subscription_reader>
          <participant_configuration_reader>
            <min_heartbeat_response_delay>
              <sec>0</sec>
              <nanosec>0</nanosec>
            </min_heartbeat_response_delay>
            <max_heartbeat_response_delay>
              <sec>1</sec>
              <nanosec>0</nanosec>
            </max_heartbeat_response_delay>
          </participant_configuration_reader>

        </discovery_config>

        <!-- Disable legacy TypeCode and TypeObject v1. LENGTH_AUTO (-2) retains
             TypeObject v2 TypeLookup replies for on-demand inspection. -->
        <resource_limits>
          <type_code_max_serialized_length>0</type_code_max_serialized_length>
          <type_object_max_serialized_length>-2</type_object_max_serialized_length>
        </resource_limits>

        <!-- Uncomment below to enable CRC checking for all messages -->
        <!-- 
          <wire_protocol>
            <compute_crc>true</compute_crc>
            <check_crc>true</check_crc>
          </wire_protocol> 
          -->

      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="wan_router_participant" base_name="ACT_QOS_LIB::wan_router_participant_base">

      <domain_participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>

          <udpv6>
            <!-- Inherited by the six-topic profiles that enable UDPv6. -->
            <multicast_ttl>$(WAN_TTL)</multicast_ttl>

            <!-- Increase the receive socket buffer size to improve performance. -->
            <recv_socket_buffer_size>2097152</recv_socket_buffer_size>
          </udpv6>
        </transport_builtin>
        <discovery>
          <initial_peers>
            <element>$(WAN_PEER)</element>
            <element>$(WAN_PEER2)</element>
            <element>$(WAN_PEER3)</element>
            <element>$(WAN_PEER4)</element>
            <element>$(WAN_PEER5)</element>
            <element>$(WAN_PEER6)</element>
            <element>$(WAN_PEER7)</element>
            <element>$(WAN_PEER8)</element>
            <element>$(WAN_PEER9)</element>
            <element>$(WAN_PEER10)</element>
            <element>$(WAN_PEER11)</element>
          </initial_peers>

          <multicast_receive_addresses>
          <element>$(WAN_RECEIVE_MULTICAST)</element>
          </multicast_receive_addresses>
        </discovery>
      </domain_participant_qos>

    </qos_profile>

    <!-- Opt-in contract profile; legacy WAN participants retain their limits. -->
    <qos_profile name="wan_two_topic_participant"
                 base_name="ACT_QOS_LIB::wan_router_participant">
      <domain_participant_qos>
        <resource_limits>
          <contentfilter_property_max_length>16384</contentfilter_property_max_length>
        </resource_limits>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="wan_router_participant_emane"
                 base_name="ACT_QOS_LIB::wan_router_participant">
      <domain_participant_qos>
        <transport_builtin>
          <udpv4>
            <allow_interfaces_list>
              <element>emane0</element>
            </allow_interfaces_list>
          </udpv4>
        </transport_builtin>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="wan_two_topic_participant_emane"
                 base_name="ACT_QOS_LIB::wan_router_participant_emane">
      <domain_participant_qos>
        <resource_limits>
          <contentfilter_property_max_length>16384</contentfilter_property_max_length>
        </resource_limits>
      </domain_participant_qos>
    </qos_profile>

    <!-- Custom-router three-topic controller: nominal 2 Mbps, not RF airtime.
         Native Routing Service uses rs_priority_participant instead. -->
    <qos_profile name="wan_three_topic_participant"
                 base_name="ACT_QOS_LIB::wan_two_topic_participant">
      <domain_participant_qos>
        <property>
          <value>
            <element>
              <name>dds.flow_controller.token_bucket.wan_priority.scheduling_policy</name>
              <value>DDS_HPF_FLOW_CONTROLLER_SCHED_POLICY</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.wan_priority.token_bucket.max_tokens</name>
              <value>1</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.wan_priority.token_bucket.tokens_added_per_period</name>
              <value>1</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.wan_priority.token_bucket.tokens_leaked_per_period</name>
              <value>0</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.wan_priority.token_bucket.bytes_per_token</name>
              <value>2500</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.wan_priority.token_bucket.period.sec</name>
              <value>0</value>
            </element>
            <element>
              <name>dds.flow_controller.token_bucket.wan_priority.token_bucket.period.nanosec</name>
              <value>10000000</value>
            </element>
          </value>
        </property>
      </domain_participant_qos>
    </qos_profile>
    <qos_profile name="wan_three_topic_participant_emane"
                 base_name="ACT_QOS_LIB::wan_three_topic_participant">
      <domain_participant_qos>
        <transport_builtin>
          <udpv4>
            <allow_interfaces_list><element>emane0</element></allow_interfaces_list>
          </udpv4>
        </transport_builtin>
      </domain_participant_qos>
    </qos_profile>

    <!-- Shared WAN endpoint bases; wire names are selected by the contract. -->
    <qos_profile name="wan_periodic" base_name="BuiltinQosLib::Generic.Common">
      <!-- Base periodic data; deadline and liveliness remain infinite. -->

      <datawriter_qos>
        <!-- Messages are sent once, does NOT ensure delivery -->
        <reliability>
          <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
        </reliability>

        <!-- Retain only the latest sample per instance on the writer. -->
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>

      </datawriter_qos>

      <datareader_qos>

        <!-- Messages are sent once, does NOT ensure delivery -->
        <reliability>
          <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
        </reliability>

        <!-- Base reader keeps 50 samples; wan_union_periodic overrides this to one. -->
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>50</depth>
        </history>

      </datareader_qos>
    </qos_profile>

    <!-- Shared Periodic policy; legacy wire topic/type names remain unchanged. -->
    <qos_profile name="wan_union_periodic" base_name="ACT_QOS_LIB::wan_periodic">
      <datawriter_qos>
        <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
        <deadline><period><sec>2</sec><nanosec>0</nanosec></period></deadline>
      </datawriter_qos>
      <datareader_qos>
        <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
        <deadline><period><sec>2</sec><nanosec>0</nanosec></period></deadline>
        <property>
          <value>
            <element>
              <name>act.presence.dead_timeout_sec</name>
              <value>$(WAN_TIMEOUT_SEC)</value>
            </element>
          </value>
        </property>
      </datareader_qos>
    </qos_profile>

    <qos_profile name="wan_event" base_name="BuiltinQosLib::Generic.Common">
      <!-- 
        QoS profile for Event Messages(Commands/CommandAck/ContactReport etc) across the comms link.

        Currently Liveliness(Small heartbeats to maintain "presence") is disabled 
        for bandwidth optimization as well as for Content Filtering use
    
        Liveliness: INF - DISABLED (DEFAULT)
        Deadline: INF - DISABLED (DEFAULT) 
        Durability: VOLATILE - DISABLED (DEFAULT)
        -->

      <datawriter_qos>
        <!-- 
          This spins up a separate thread to send out samples asynchronously
          Commands tend to be larger and including "repairs" can bog down the main write thread
          -->
        <publish_mode>
          <kind>ASYNCHRONOUS_PUBLISH_MODE_QOS</kind>
        </publish_mode>

        <!-- Messages are resent if not delivered -->
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>

          <!-- 
            Will block with KEEP_ALL if the queue is "full" from samples not being
            acknowledged 
          -->
          <max_blocking_time>
            <sec>$(WAN_MAX_BLOCKING_SEC)</sec>
            <nanosec>0</nanosec>
          </max_blocking_time>
        </reliability>

        <!-- Retention is subject to resource limits and reader-inactivity policy. -->
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>

        <protocol>

          <rtps_reliable_writer>

            <!-- Bounds retries before an unresponsive reader is marked inactive.
                 This does not change writer reliability or guarantee a wall-clock timeout. -->
            <max_heartbeat_retries>$(WAN_HB_RETRIES)</max_heartbeat_retries>

            <!-- Adjust Heartbeat per RTT of WAN network -->
            <low_watermark>0</low_watermark>
            <high_watermark>1</high_watermark>
            <heartbeat_period>
              <sec>$(WAN_HB_PERIOD_SEC)</sec>
              <nanosec>0</nanosec>
            </heartbeat_period>
            <fast_heartbeat_period>
              <sec>$(WAN_HB_PERIOD_SEC)</sec>
              <nanosec>0</nanosec>
            </fast_heartbeat_period>
            <late_joiner_heartbeat_period>
              <sec>$(WAN_HB_PERIOD_SEC)</sec>
              <nanosec>0</nanosec>
            </late_joiner_heartbeat_period>
            <heartbeats_per_max_samples>0</heartbeats_per_max_samples>
            <min_nack_response_delay>
              <sec>0</sec>
              <nanosec>0</nanosec>
            </min_nack_response_delay>
            <max_nack_response_delay>
              <sec>0</sec>
              <nanosec>0</nanosec>
            </max_nack_response_delay>

          </rtps_reliable_writer>
        </protocol>

      </datawriter_qos>

      <!-- Data Reader QOS -->
      <datareader_qos>

        <!-- Messages are resent if not delivered -->
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>

        <!-- 
          Queue for samples being provided to the application

          KEEP_ALL will not overwrite older messages
          -->
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>

        <!-- 
          This increases the buffer of messages before they are fully received 
          FIFO and provided to the application.

          In scenarios with high latency/long RTT(Round Trip Time) it allows for
          missing dropped samples.

          Default: 256
          -->
        <protocol>
          <rtps_reliable_reader>
            <receive_window_size>512</receive_window_size>

          </rtps_reliable_reader>
        </protocol>

        <property>
          <value>
            <element>
              <name>dds.data_reader.protocol.disable_preemptive_nack</name>
              <value>true</value>
            </element>
          </value>
        </property>

      </datareader_qos>

    </qos_profile>

    <qos_profile name="wan_three_topic_event" base_name="ACT_QOS_LIB::wan_event">
      <datawriter_qos>
        <publish_mode>
          <kind>ASYNCHRONOUS_PUBLISH_MODE_QOS</kind>
          <flow_controller_name>dds.flow_controller.token_bucket.wan_priority</flow_controller_name>
          <priority>-1</priority>
        </publish_mode>
        <multi_channel>
          <filter_name>DDSPRIFLTR</filter_name>
          <channels>
            <element><filter_expression>@priority &gt;= 100</filter_expression><priority>-1</priority><multicast_settings/></element>
            <element><filter_expression>@priority &lt; 100</filter_expression><priority>-1</priority><multicast_settings/></element>
          </channels>
        </multi_channel>
        <protocol>
          <rtps_reliable_writer>
            <max_bytes_per_nack_response>65536</max_bytes_per_nack_response>
          </rtps_reliable_writer>
        </protocol>
      </datawriter_qos>
    </qos_profile>
    <qos_profile name="wan_union_contacts" base_name="ACT_QOS_LIB::wan_three_topic_event">
      <datawriter_qos>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
      </datawriter_qos>
      <!-- Reader KEEP_ALL and default heartbeat suppression are inherited. -->
    </qos_profile>

    <!-- Legacy WAN health and shared LAN monitoring endpoints. -->
    <qos_profile name="router_health" base_name="ACT_QOS_LIB::wan_event">
      <!--
        RouterHealth presence heartbeat on the WAN participant.

        Periodic latest-state data uses best effort: the next heartbeat supersedes a
        missed one. Override reliability at both endpoints while retaining the existing
        base defaults and presence-specific cache/deadline/liveliness settings.
      -->

      <datawriter_qos>
        <reliability>
          <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
        </durability>

        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>

        <deadline>
          <period>
            <sec>2</sec>
            <nanosec>0</nanosec>
          </period>
        </deadline>

        <liveliness>
          <kind>AUTOMATIC_LIVELINESS_QOS</kind>
          <lease_duration>
            <sec>3</sec>
            <nanosec>0</nanosec>
          </lease_duration>
        </liveliness>
      </datawriter_qos>

      <datareader_qos>
        <reliability>
          <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
        </durability>

        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>

        <deadline>
          <period>
            <sec>2</sec>
            <nanosec>0</nanosec>
          </period>
        </deadline>

        <liveliness>
          <kind>AUTOMATIC_LIVELINESS_QOS</kind>
          <lease_duration>
            <sec>3</sec>
            <nanosec>0</nanosec>
          </lease_duration>
        </liveliness>
      </datareader_qos>
    </qos_profile>

    <qos_profile name="router_mesh_status" base_name="BuiltinQosLib::Generic.Common">
      <datawriter_qos>
        <publish_mode>
          <kind>ASYNCHRONOUS_PUBLISH_MODE_QOS</kind>
        </publish_mode>
        <reliability>
          <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
