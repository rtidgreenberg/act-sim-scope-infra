    <qos_profile name="rs_six_topic_p3_periodic" base_name="ACT_QOS_LIB::rs_three_topic_periodic">
      <datawriter_qos>
        <transport_priority><value>104</value></transport_priority>
        <multi_channel>
          <filter_name>DDSPRIFLTR</filter_name>
          <channels>
            <element><filter_expression>@priority &gt;= 150</filter_expression><priority>-1</priority><multicast_settings/></element>
            <element><filter_expression>@priority &lt; 150</filter_expression><priority>-1</priority><multicast_settings/></element>
          </channels>
        </multi_channel>
      </datawriter_qos>
    </qos_profile>

    <!-- Runtime reader lifecycle and LAN administration/diagnostics.
         Lifecycle retention is composed into union adapter inputs. -->
    <qos_profile name="router_lifecycle_reader">
      <datareader_qos>
        <reader_data_lifecycle>
          <autopurge_nowriter_instances_delay>
            <sec>DURATION_INFINITE_SEC</sec>
            <nanosec>DURATION_INFINITE_NSEC</nanosec>
          </autopurge_nowriter_instances_delay>
          <autopurge_disposed_instances_delay>
